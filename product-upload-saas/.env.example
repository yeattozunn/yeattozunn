# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/ideasoft_saas

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# AES-256 key for encrypting IdeaSoft credentials / TOTP secrets.
# Must be exactly 32 bytes. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# API server
PORT=3000

# Google service account (for Sheets API access) - path to JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# AI services (used by the Playwright worker, not the API server)
GEMINI_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
